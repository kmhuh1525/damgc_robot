<?xml version="1.0"?>
<package format="3">
  <name>cooperative_transport</name><version>0.1.0</version>
  <description>Manual-grasp coordinated path transport without arm actuation.</description>
  <maintainer email="maze@todo.todo">maze</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>map_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>follower_command_selector</exec_depend>
  <exec_depend>follower_control</exec_depend><exec_depend>stm32_bridge</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
